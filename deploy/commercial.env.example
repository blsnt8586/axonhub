# Copy to a protected environment file outside Git before production use.
# Generate both secrets independently; do not keep these example values.
DB_PASSWORD=replace-with-a-long-random-database-password
AXONHUB_PAYMENT_SECRET_KEY=replace-with-a-long-random-payment-encryption-secret

# Bind PostgreSQL locally. Bind AxonHub locally when a reverse proxy is used.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
AXONHUB_BIND_ADDRESS=127.0.0.1
AXONHUB_PORT=8090

# Keep one application replica while auto-migration is enabled.
AXONHUB_DB_DISABLE_AUTO_MIGRATION=false
AXONHUB_DB_MAX_OPEN_CONNS=50
AXONHUB_DB_MAX_IDLE_CONNS=20

# First production rollout starts in warn mode. Promote to enforce only after
# pricing, wallet, outbox, and real gateway traffic have been inspected.
AXONHUB_BILLING_MODE=warn
AXONHUB_BILLING_SUBJECT=user
AXONHUB_BILLING_CURRENCY=CNY
AXONHUB_BILLING_ALLOW_NEGATIVE=false
AXONHUB_BILLING_BLOCK_WHEN_NO_PRICE_RULE=true
AXONHUB_BILLING_OUTBOX_WORKER_INTERVAL_SECONDS=60
AXONHUB_BILLING_OUTBOX_MAX_ATTEMPTS=10

AXONHUB_LOG_LEVEL=info
AXONHUB_LOG_ENCODING=json
AXONHUB_LOG_OUTPUT=stdio
